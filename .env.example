# Neo4j Connection
# For local Docker:
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# For Neo4j AuraDS:
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_aura_password

# Anthropic API Key (for Claude Agent SDK)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI API Key (for text embeddings)
OPENAI_API_KEY=your_openai_api_key

# Optional: Claude model for the agent (full id or alias sonnet/opus/haiku); empty = SDK default
# CLAUDE_MODEL=opus

# TypeSafe AI API Key (for Jev typed yes/no/needs_llm_decision verdicts)
TYPESAFE_API_KEY=your_typesafe_api_key
# Optional: model and confidence floor below which verdicts escalate to the LLM
# TYPESAFE_MODEL=jev-latest
# JEV_CONFIDENCE_FLOOR=0.6
